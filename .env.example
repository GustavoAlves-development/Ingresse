# Connection string do branch de desenvolvimento do Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo usado pelo Auth.js para assinar/verificar o JWT de sessão.
# Gere um valor real com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-real-random-secret"

# Mercado Pago Developers — aplicação de teste
MERCADO_PAGO_ACCESS_TOKEN="replace-with-a-real-test-access-token"
MERCADO_PAGO_WEBHOOK_SECRET="replace-with-a-real-webhook-secret"

# Resend — API key para envio de e-mail transacional
RESEND_API_KEY="replace-with-a-real-resend-api-key"

# URL pública do app, usada para montar a notification_url do webhook
APP_URL="http://localhost:3000"

# Vercel Blob — token de leitura/escrita para upload de imagens
BLOB_READ_WRITE_TOKEN="replace-with-a-real-vercel-blob-token"
